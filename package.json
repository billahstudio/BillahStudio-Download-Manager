{
  "name": "billahstudio-download-manager",
  "version": "1.0.1",
  "description": "A Windows download manager with segmented transfers and browser video capture",
  "main": "desktop/main.cjs",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/billahstudio/BillahStudio-Download-Manager.git" },
  "bugs": { "url": "https://github.com/billahstudio/BillahStudio-Download-Manager/issues" },
  "author": "Billah Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs integration/*.test.cjs extension/*.test.cjs",
    "package": "electron-builder --win dir",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "build:web": "npm --prefix website install && npm --prefix website run build",
    "dev:web": "npm --prefix website run dev",
    "preview:web": "npm --prefix website run preview"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.58.2"
  },
  "build": {
    "appId": "com.billahstudio.downloadmanager",
    "productName": "BillahStudio-Download-Manager",
    "publisherName": ["Billah Studio"],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "core/**/*",
      "renderer/**/*",
      "assets/**/*",
      "integration/**/*",
      "extension/**/*",
      "THIRD-PARTY.md",
      "LICENSE",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      { "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE", "to": "licenses/FFmpeg-LICENSE.txt" },
      { "from": "node_modules/ffmpeg-static/ffmpeg.exe.README", "to": "licenses/FFmpeg-BUILD.txt" },
      { "from": "node_modules/ffmpeg-static/LICENSE", "to": "licenses/ffmpeg-static-LICENSE.txt" },
      { "from": "node_modules/googlevideo/LICENSE", "to": "licenses/googlevideo-LICENSE.txt" },
      {
        "from": "vendor",
        "to": "tools",
        "filter": [
          "yt-dlp.exe",
          "*.txt"
        ]
      },
      {
        "from": "extension",
        "to": "browser/extension",
        "filter": [
          "**/*",
          "!*.test.cjs"
        ]
      },
      {
        "from": "integration",
        "to": "browser/integration",
        "filter": [
          "native-host.exe",
          "native-host.cjs",
          "NativeHostLauncher.cs",
          "README.md",
          "register-native-host.ps1"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe"
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "legalTrademarks": "Billah Studio",
      "legalCopyright": "Copyright © 2026 Billah Studio",
      "companyName": "Billah Studio",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "BillahStudio-Download-Manager-${version}-Windows.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BillahStudio-Download-Manager",
      "artifactName": "BillahStudio-Download-Manager.exe"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "googlevideo": "^5.0.1"
  }
}
